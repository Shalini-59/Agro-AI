_name\":\"Gzip\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1851602600\":{\"name\":\"1851602600\",\"rule_id\":\"4eTK4MlItkURcyZvgC5EMN-4eTK4KGG12LmT9rzFua1tL\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"userID\",\"value\":{\"mode\":\"composer\",\"suggestions\":[{\"id\":\"shorter\",\"prompt\":\"Make the lessons in my course shorter\",\"label\":\"Shorter lessons\"},{\"label\":\"More basics\",\"prompt\":\"Focus my course more on the basics, with simpler explanations\",\"id\":\"basics\"},{\"prompt\":\"Add more conversation practice to my course\",\"label\":\"More conversation practice\",\"id\":\"conversation\"}],\"placeholder\":\"How would you like to personalize your lessons?\"},\"is_device_based\":false,\"passed\":true},\"1935984042\":{\"name\":\"1935984042\",\"rule_id\":\"3Jf7HoIkV5WT3x9DmkXXZG:100.00:7-3Jf7Hn3isNNoK7BHLd2kGE\",\"secondary_exposures\":[],\"version\":102,\"id_type\":\"userID\",\"value\":{\"native_document_limits\":{\"granola_whiteboard\":{\"max_block_count\":10000,\"max_title_unicode_scalars\":512,\"max_materialized_markdown_bytes\":1048576,\"max_document_depth\":64,\"max_document_bytes\":10485760,\"max_raw_update_bytes\":524288,\"max_document_nodes\":750000},\"granola_presentation\":{\"max_document_bytes\":10485760,\"max_materialized_markdown_bytes\":1048576,\"max_document_nodes\":750000,\"max_block_count\":10000,\"max_document_depth\":64,\"max_title_unicode_scalars\":512,\"max_raw_update_bytes\":524288},\"granola_workbook\":{\"max_raw_update_bytes\":524288,\"max_materialized_markdown_bytes\":1048576,\"max_title_unicode_scalars\":512,\"max_block_count\":10000,\"max_document_bytes\":10485760,\"max_document_nodes\":750000,\"max_document_depth\":64}},\"enabled_document_types\":[\"page\",\"granola_workbook\",\"granola_presentation\",\"granola_whiteboard\",\"dashboard\"]},\"is_device_based\":false,\"passed\":true},\"1965446322\":{\"name\":\"1965446322\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\"